<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>
<?import javafx.scene.control.Label?>

<VBox alignment="CENTER" spacing="20" xmlns="http://javafx.com/javafx/25" 
      xmlns:fx="http://javafx.com/fxml/1" 
      fx:controller="cda.bibliotheque.controller.PrimaryController">
    
    <children>
        <Label text="Gestion de Bibliothèque">
            <font>
                <Font size="24.0" />
            </font>
            <VBox.margin>
                <Insets bottom="30.0" />
            </VBox.margin>
        </Label>
        
        <Button text="Gérer les Livres" onAction="#switchToBooks" 
                style="-fx-font-size: 14px; -fx-pref-width: 200px;" />
        
        <Button text="Gérer les Auteurs" onAction="#switchToAuthors" 
                style="-fx-font-size: 14px; -fx-pref-width: 200px;" />

        <Button text="Gérer les Éditeurs" onAction="#switchToEditors" 
                style="-fx-font-size: 14px; -fx-pref-width: 200px;" />

        <Button text="Gérer les Clients" onAction="#switchToClients" 
                style="-fx-font-size: 14px; -fx-pref-width: 200px;" />

    </children>
    
    <padding>
        <Insets top="20.0" right="20.0" bottom="20.0" left="20.0" />
    </padding>
</VBox>